        "    layers.Dense(10, activation='relu'),\n",
        "    layers.Dense(8, activation='relu'),\n",
        "    layers.Dense(1, activation='linear')\n",
        "])\n",
        "\n",
        "model_reg.compile(optimizer='adam', loss='mse')\n",
